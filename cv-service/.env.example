# Copy to .env and fill in. NEVER commit real values.
# Every name below is read by the code; scripts fail fast if a required one is missing.

# ── Supabase (all scripts) ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Service-role key (server-side only). SUPABASE_KEY is still accepted as a legacy alias.
SUPABASE_SERVICE_KEY=
PROPERTY_ID=a0000000-0000-0000-0000-000000000001
# Exit non-zero after this many consecutive failed database writes
MAX_CONSECUTIVE_PUSH_FAILURES=5

# ── main.py — snapshot occupancy on the internal camera network ──
# Cameras must be registered in camera_feeds (name = id from config/cameras.py,
# e.g. "N2-D1", with a zone) or carry feed_id in config/cameras.py.
CAMERA_USERNAME=admin
CAMERA_PASSWORD=
CAPTURE_INTERVAL_SECONDS=300
CONFIDENCE_THRESHOLD=0.5
YOLO_MODEL=yolov8n.pt

# ── live_count.py — single camera via ffmpeg ──────────────────
RTSP_HOST=
RTSP_USERNAME=admin
RTSP_PASSWORD=
RTSP_PORT=554
RTSP_CHANNEL=101
# Zone (UUID) the live camera's occupancy is written to
LIVE_COUNT_ZONE_ID=
YOLO_CONFIDENCE=0.15
YOLO_IMAGE_SIZE=1280

# ── gate_counter.py — gate line-crossing counters via OSD OCR ──
GATE_HOST=
GATE_USERNAME=admin
GATE_PASSWORD=
# Zone (UUID) that gate entries/exits and the daily total are written to
GATE_ZONE_ID=
GATE_INTERVAL_SECONDS=300
# Per gate counter; larger jumps are capped to this rate and flagged (confidence 0.6)
GATE_MAX_ENTRIES_PER_MINUTE=100
